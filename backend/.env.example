# ─────────────────────────────────────────────
# Backend Environment Variables — DO NOT COMMIT
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Optional: Google Analytics Measurement ID (server-side events)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Secret key for future auth / signed tokens
APP_SECRET_KEY=change-me-to-a-strong-random-value

# Environment: development | production
ENVIRONMENT=development
